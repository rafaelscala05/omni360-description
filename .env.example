# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurações do Vertex AI (Para Geração de Imagem via GCP)
# VERTEX_PROJECT_ID: ID do projeto no Google Cloud
VERTEX_PROJECT_ID=
# VERTEX_LOCATION: Localização do projeto no Google Cloud (ex: us-central1)
VERTEX_LOCATION=

# Asaas payment gateway
ASAAS_API_KEY=your_asaas_api_key_here
# Produção: https://api.asaas.com/v3 — Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=your_webhook_token_here

# Agência de Criação de Conteúdo (Alfred)
# CONTENT_CRON_SECRET: segredo compartilhado que protege o endpoint
# POST /api/content/cron/tick. Em produção, o Cloud Scheduler envia este valor
# no header `x-content-cron-secret`. Em dev, o node-cron interno reusa o mesmo.
CONTENT_CRON_SECRET=

# App Check (somente DEV/localhost): cole o debug token gerado no Firebase Console
# em App Check → Apps → (seu app) → Manage debug tokens. Não é necessário em produção.
VITE_APPCHECK_DEBUG_TOKEN=
