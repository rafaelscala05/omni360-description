# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurações do Vertex AI (Para Geração de Imagem via GCP)
# VERTEX_PROJECT_ID: ID do projeto no Google Cloud
VERTEX_PROJECT_ID=
# VERTEX_LOCATION: Localização do projeto no Google Cloud (ex: us-central1)
VERTEX_LOCATION=

# Asaas payment gateway
ASAAS_API_KEY=your_asaas_api_key_here
# Produção: https://api.asaas.com/v3 — Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=your_webhook_token_here

# Agência de Criação de Conteúdo (Alfred)
# CONTENT_CRON_SECRET: segredo compartilhado que protege o endpoint
# POST /api/content/cron/tick. Em produção, o Cloud Scheduler envia este valor
# no header `x-content-cron-secret`. Em dev, o node-cron interno reusa o mesmo.
CONTENT_CRON_SECRET=

# App Check (somente DEV/localhost): cole o debug token gerado no Firebase Console
# em App Check → Apps → (seu app) → Manage debug tokens. Não é necessário em produção.
VITE_APPCHECK_DEBUG_TOKEN=

# Meta Ads (Pixel + Conversions API)
# VITE_META_PIXEL_ID: Pixel ID do Meta Events Manager (público, vai no bundle do client).
VITE_META_PIXEL_ID=
# META_CONVERSIONS_API_TOKEN: Access Token da Conversions API, gerado em
# Events Manager → (Pixel) → Configurações → Conversions API → "Gerar token de acesso".
# Secreto — nunca prefixar com VITE_ (não pode ir ao client).
META_CONVERSIONS_API_TOKEN=
# META_TEST_EVENT_CODE: opcional. Código do Events Manager → aba "Test Events",
# usado para validar eventos em tempo real durante o desenvolvimento.
META_TEST_EVENT_CODE=

# SE Ranking — Data API (auditoria de SEO + pesquisa de palavras-chave do
# Agente de Conteúdo). Gerada em: SE Ranking → ícone API no menu lateral →
# API Dashboard → "+ CREATE API KEY". Secreta — só no servidor, nunca
# prefixar com VITE_. Base URL: https://api.seranking.com (Authorization: Token <key>).
SE_RANKING_API_KEY=b0ae2ef2-8ed7-3573-8631-22fbf4d00abf

# Tiny ERP (Olist) — API v3, OAuth2 (app único publicado do omni360).
# Gerados em: Tiny → Configurações → Aplicativos → novo aplicativo.
# Secretos — só no servidor, nunca prefixar com VITE_.
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
# TINY_REDIRECT_URI: deve ser idêntica à URL de redirecionamento cadastrada no
# aplicativo Tiny. Ex.: https://SEU_DOMINIO/api/tiny/oauth/callback
TINY_REDIRECT_URI=
# TINY_PACE_MS (opcional): espaçamento em ms entre chamadas de detalhe na
# importação, para respeitar o rate limit por minuto do Tiny. Padrão 1000
# (~60 req/min, seguro no plano base). Planos maiores podem baixar (ex.: 300).
TINY_PACE_MS=

# Bling ERP — API v3, OAuth2 (app único publicado do omni360).
# Gerados em: Bling → Preferências → Cadastro de aplicativos → novo aplicativo.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# BLING_REDIRECT_URI: idêntica à URL de redirecionamento cadastrada no app Bling.
# Ex.: https://SEU_DOMINIO/api/bling/oauth/callback
BLING_REDIRECT_URI=
# BLING_SCOPES (opcional): escopos separados por espaço. Vazio = usa os do app.
BLING_SCOPES=
# BLING_PACE_MS (opcional): espaçamento em ms entre chamadas de detalhe na
# importação (Bling ~3 req/s). Padrão 350.
BLING_PACE_MS=
# BLING_CRON_SECRET (opcional): protege POST /api/bling/cron/tick; fallback p/
# CONTENT_CRON_SECRET. Enviado pelo Cloud Scheduler no header x-bling-cron-secret.
BLING_CRON_SECRET=
# BLING_UPDATE_DATE_PARAM (opcional): nome do parâmetro de filtro por data no
# GET /produtos usado no modo "update". Vazio = modo update pagina o catálogo todo.
BLING_UPDATE_DATE_PARAM=
