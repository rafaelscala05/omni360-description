# GEMINI_API_KEY: Required for the video agent's Gemini Developer API (AI
# Studio) calls (server/videoAgent.ts — roteiro/texto do vídeo).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurações do Vertex AI — usado pelo Agente de Conteúdo (Alfred, texto +
# imagem de capa, server/contentAgent.ts) e pelo Veo (vídeo, server/videoAgent.ts).
# Auth via ADC (identidade da instância do Cloud Run/App Hosting), não API key.
# VERTEX_PROJECT_ID: ID do projeto no Google Cloud (default: projeto do Firebase).
VERTEX_PROJECT_ID=
# VERTEX_LOCATION: Localização do projeto no Google Cloud (default: us-central1).
VERTEX_LOCATION=

# CONTENT_AGENT_LANGGRAPH_URL: URL do servidor LangGraph.js do Agente de
# Conteúdo conversacional (Dockerfile.contentAgent, serviço Cloud Run próprio
# em produção). Consumida só pelo app principal (server/copilotRuntime.ts)
# para encaminhar o /api/copilotkit até o grafo.
CONTENT_AGENT_LANGGRAPH_URL=http://localhost:8123

# Asaas payment gateway
ASAAS_API_KEY=your_asaas_api_key_here
# Produção: https://api.asaas.com/v3 — Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=your_webhook_token_here

# Agência de Criação de Conteúdo (Alfred)
# CONTENT_CRON_SECRET: segredo compartilhado que protege o endpoint
# POST /api/content/cron/tick. Em produção, o Cloud Scheduler envia este valor
# no header `x-content-cron-secret`. Em dev, o node-cron interno reusa o mesmo.
CONTENT_CRON_SECRET=

# App Check (somente DEV/localhost): cole o debug token gerado no Firebase Console
# em App Check → Apps → (seu app) → Manage debug tokens. Não é necessário em produção.
VITE_APPCHECK_DEBUG_TOKEN=

# Meta Ads (Pixel + Conversions API)
# VITE_META_PIXEL_ID: Pixel ID do Meta Events Manager (público, vai no bundle do client).
VITE_META_PIXEL_ID=
# META_CONVERSIONS_API_TOKEN: Access Token da Conversions API, gerado em
# Events Manager → (Pixel) → Configurações → Conversions API → "Gerar token de acesso".
# Secreto — nunca prefixar com VITE_ (não pode ir ao client).
META_CONVERSIONS_API_TOKEN=
# META_TEST_EVENT_CODE: opcional. Código do Events Manager → aba "Test Events",
# usado para validar eventos em tempo real durante o desenvolvimento.
META_TEST_EVENT_CODE=

# TikTok Ads (Pixel + Events API)
# VITE_TIKTOK_PIXEL_ID: Pixel ID do TikTok Events Manager (público, vai no bundle
# do client). Precisa bater com o pixel hardcoded em src/tiktok.ts.
VITE_TIKTOK_PIXEL_ID=
# TIKTOK_ACCESS_TOKEN: Access Token da Events API, gerado em Events Manager →
# (Pixel) → Configurações → Events API → "Gerar token de acesso".
# Secreto — nunca prefixar com VITE_ (não pode ir ao client).
TIKTOK_ACCESS_TOKEN=
# TIKTOK_TEST_EVENT_CODE: opcional. Código do Events Manager → aba "Test Events",
# usado para validar eventos em tempo real durante o desenvolvimento.
TIKTOK_TEST_EVENT_CODE=

# SE Ranking — Data API (auditoria de SEO + pesquisa de palavras-chave do
# Agente de Conteúdo). Gerada em: SE Ranking → ícone API no menu lateral →
# API Dashboard → "+ CREATE API KEY". Secreta — só no servidor, nunca
# prefixar com VITE_. Base URL: https://api.seranking.com (Authorization: Token <key>).
SE_RANKING_API_KEY=b0ae2ef2-8ed7-3573-8631-22fbf4d00abf

# Tiny ERP (Olist) — API v3, OAuth2 (app único publicado do omni360).
# Gerados em: Tiny → Configurações → Aplicativos → novo aplicativo.
# Secretos — só no servidor, nunca prefixar com VITE_.
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
# TINY_REDIRECT_URI: deve ser idêntica à URL de redirecionamento cadastrada no
# aplicativo Tiny. Ex.: https://SEU_DOMINIO/api/tiny/oauth/callback
TINY_REDIRECT_URI=
# TINY_PACE_MS (opcional): espaçamento em ms entre chamadas de detalhe na
# importação, para respeitar o rate limit por minuto do Tiny. Padrão 1000
# (~60 req/min, seguro no plano base). Planos maiores podem baixar (ex.: 300).
TINY_PACE_MS=

# Bling ERP — API v3, OAuth2 (app único publicado do omni360).
# Gerados em: Bling → Preferências → Cadastro de aplicativos → novo aplicativo.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# BLING_REDIRECT_URI: idêntica à URL de redirecionamento cadastrada no app Bling.
# Ex.: https://SEU_DOMINIO/api/bling/oauth/callback
BLING_REDIRECT_URI=
# BLING_SCOPES (opcional): escopos separados por espaço. Vazio = usa os do app.
BLING_SCOPES=
# BLING_PACE_MS (opcional): espaçamento em ms entre chamadas de detalhe na
# importação (Bling ~3 req/s). Padrão 350.
BLING_PACE_MS=
# BLING_CRON_SECRET (opcional): protege POST /api/bling/cron/tick; fallback p/
# CONTENT_CRON_SECRET. Enviado pelo Cloud Scheduler no header x-bling-cron-secret.
BLING_CRON_SECRET=
# BLING_UPDATE_DATE_PARAM (opcional): nome do parâmetro de filtro por data no
# GET /produtos usado no modo "update". Vazio = modo update pagina o catálogo todo.
BLING_UPDATE_DATE_PARAM=

# IdWorks ERP — auth é por usuário (accountName + credenciais), não OAuth de
# app único: credenciais ficam em users/{uid}/integration_secrets/idworks no
# Firestore, nunca em variável de ambiente.
# IDWORKS_PACE_MS (opcional): espaçamento em ms entre chamadas à API da IdWorks.
# Padrão 200 (rate limit não documentado publicamente; valor conservador).
IDWORKS_PACE_MS=200
# IDWORKS_CRON_SECRET (opcional): protege POST /api/idworks/cron/tick; fallback p/
# CONTENT_CRON_SECRET. Enviado pelo Cloud Scheduler no header x-idworks-cron-secret.
IDWORKS_CRON_SECRET=

# --- WhatsApp Oficial (Meta Cloud API) — automação do CRM ---
# Sem estas variáveis o CRM funciona inteiro, só a régua de WhatsApp fica inerte.
# Token permanente de System User com a permissão whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# ID do número remetente (Meta Business > WhatsApp > Números).
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta WhatsApp Business — usado para listar os templates aprovados.
WHATSAPP_WABA_ID=
# Teto de envios por rodada do worker (padrão 50). Trava contra disparo em massa
# por bug no derivador de etapa.
WHATSAPP_MAX_PER_DAY=50
# true = percorre a régua e registra os envios SEM chamar a Meta. Use para validar
# uma automação nova antes de apontar para clientes reais.
WHATSAPP_DRY_RUN=false

# E-mail (SMTP genérico — Gmail Workspace, SES, SendGrid SMTP relay, Zoho etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Omni360 <no-reply@seudominio.com>"
EMAIL_DRY_RUN=false
EMAIL_MAX_PER_DAY=100

# --- CRM admin (/admin) ---
# Allowlist de bootstrap, separada por vírgula. Existe porque conceder o custom
# claim `admin` exige a API Admin de Auth, que por sua vez exige uma service
# account — sem isto não haveria como abrir o CRM pela primeira vez numa máquina
# com ADC de usuário. O claim continua funcionando e é o que escala para outros
# admins (npx tsx scripts/set-admin-claim.mjs <email>).
# Só liste e-mails cujas contas você já criou.
ADMIN_EMAILS=

# Blog — domínios de cliente via Cloudflare for SaaS (server/cloudflareSaas.ts).
# O cliente aponta um CNAME do domínio dele para CLOUDFLARE_SAAS_CNAME_TARGET;
# a Cloudflare emite o certificado por hostname e encaminha para o Worker, que
# reescreve o Host para o App Hosting e injeta X-Forwarded-Host.
# Sem CLOUDFLARE_API_TOKEN/CLOUDFLARE_ZONE_ID as rotas de domínio respondem 503
# e o resto do módulo Blog funciona inteiro.
# Token: escopo Zone → SSL and Certificates → Edit, na zona do CNAME target.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_CNAME_TARGET=blogs.alfreds.com.br
# Segredo compartilhado com o Worker. Enquanto vazio, X-Forwarded-Host é aceito
# de qualquer origem (comportamento antigo, que mantém funcionando o proxy
# reverso em /blog do próprio cliente). Preencher só junto com o deploy do
# Worker — antes disso os domínios de cliente param de resolver.
BLOG_PROXY_SECRET=
