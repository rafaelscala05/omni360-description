rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredProductFields() {
      return request.resource.data.keys().hasAll(['ownerId', 'createdAt']);
    }
    
    function hasRequiredTemplateFields() {
      return request.resource.data.keys().hasAll(['name', 'prompt', 'ownerId', 'createdAt']);
    }

    function isValidProduct() {
      let data = request.resource.data;
      return data.ownerId is string &&
             data.createdAt is string &&
             // Internal fields
             (!('_id' in data) || data._id is string) &&
             (!('_statusDescricao' in data) || data._statusDescricao is string) &&
             (!('_statusSEO' in data) || data._statusSEO is string) &&
             (!('_enrichmentLog' in data) || data._enrichmentLog is string) &&
             (!('_generationLog' in data) || data._generationLog is string) &&
             (!('_selectedImage' in data) || data._selectedImage is string) &&
             (!('_ambientImages' in data) || data._ambientImages is list) &&
             (!('_tokenUsage' in data) || data._tokenUsage is map) &&
             // SEO fields (actual keys from App.tsx)
             (!('Título SEO' in data) || data['Título SEO'] is string) &&
             (!('Descrição SEO' in data) || data['Descrição SEO'] is string) &&
             (!('Palavras chave SEO' in data) || data['Palavras chave SEO'] is string) &&
             (!('Descrição complementar' in data) || data['Descrição complementar'] is string);
    }

    function isValidUser() {
      let data = request.resource.data;
      return (!('email' in data) || data.email is string || data.email == null) &&
             (!('displayName' in data) || data.displayName is string || data.displayName == null) &&
             (!('phone' in data) || data.phone is string || data.phone == null) &&
             (!('productOnboarding' in data) || data.productOnboarding is map) &&
             (!('credits' in data) || data.credits is number) &&
             (!('lastSync' in data) || data.lastSync is string);
    }

    // On update, the client may only keep credits the same or DECREASE them
    // (debits via consumeCredit). Any increase (top-up/recharge) must happen
    // server-side with the Admin SDK, which bypasses these rules. This closes
    // the hole where a client could set its own credits to an arbitrary value.
    function creditsNotIncreased() {
      return !('credits' in request.resource.data)
          || !('credits' in resource.data)
          || request.resource.data.credits <= resource.data.credits;
    }

    // O resumo do CRM (users/{uid}.crm) é escrito só pelo servidor via Admin SDK,
    // que bypassa estas regras. O cliente não pode criá-lo nem alterá-lo — senão
    // poderia mentir sobre o próprio estágio na jornada de ativação.
    function crmNotTouched() {
      return !('crm' in request.resource.data)
          || (('crm' in resource.data) && request.resource.data.crm == resource.data.crm);
    }

    // Idem para hasPurchased, que alimenta o health score e é escrito apenas
    // pelo webhook de pagamento.
    function purchaseFlagNotTouched() {
      return !('hasPurchased' in request.resource.data)
          || (('hasPurchased' in resource.data) && request.resource.data.hasPurchased == resource.data.hasPurchased);
    }

    function isValidTemplate() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() < 5000 &&
             data.ownerId is string &&
             data.createdAt is string;
    }

    function isValidCategory() {
      let data = request.resource.data;
      return (!('id' in data) || data.id is string) &&
             (!('name' in data) || data.name is string) &&
             (!('slug' in data) || data.slug is string) &&
             (!('parentId' in data) || data.parentId is string || data.parentId == null) &&
             (!('level' in data) || data.level is number) &&
             (!('path' in data) || data.path is list) &&
             (!('pathIds' in data) || data.pathIds is list) &&
             (!('attributes' in data) || data.attributes is list) &&
             (!('inheritParentAttributes' in data) || data.inheritParentAttributes is bool) &&
             (!('productCount' in data) || data.productCount is number) &&
             (!('aiGenerated' in data) || data.aiGenerated is bool) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Admin-controlled, read-only configuration (e.g. per-action credit costs).
    // Writes happen only via the Admin SDK / Firebase console, never the client.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pagamentos pendentes — escritos apenas pelo servidor via Admin SDK.
    // O cliente nunca deve ler nem escrever nesta coleção.
    match /pendingPayments/{paymentId} {
      allow read, write: if false;
    }

    // Lookup público do blog (slug → tenant, domínio → tenant). Escritas e
    // leituras apenas pelo servidor via Admin SDK; o cliente é negado.
    match /blogSlugs/{slug} {
      allow read, write: if false;
    }
    match /blogDomains/{domain} {
      allow read, write: if false;
    }

    // Leads do site de marketing (formulário de contato). Criação pública
    // (sem autenticação), mas ninguém — nem o próprio autor — pode ler,
    // atualizar ou apagar pelo cliente; leitura é só via console/Admin SDK.
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Indique e Ganhe (referral) records. The referrer credit bonus depends on
    // this doc's idempotency flags, so it's fully server-managed via the Admin
    // SDK (server/referralAgent.ts) — the client reads its own referrals through
    // GET /api/referrals/me instead of a direct Firestore query.
    match /referrals/{referralId} {
      allow read, write: if false;
    }

    // CRM admin — tarefas e trilha de auditoria. Escritas e leituras apenas pelo
    // servidor via Admin SDK (server/crmAdmin.ts); o cliente é totalmente negado.
    match /crm_tasks/{taskId} {
      allow read, write: if false;
    }
    match /crm_audit/{auditId} {
      allow read, write: if false;
    }
    // Régua de WhatsApp por etapa do Kanban — escrita só pelo admin via Admin SDK.
    match /crm_automations/{stage} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser()
                    && !('crm' in request.resource.data)
                    && !('hasPurchased' in request.resource.data);
      allow update: if isOwner(userId) && isValidUser() && creditsNotIncreased()
                    && crmNotTouched() && purchaseFlagNotTouched();
      allow delete: if isOwner(userId);

      // Eventos do CRM e notas do admin. Escritos pelo servidor via Admin SDK;
      // nem o próprio usuário lê ou escreve.
      match /events/{eventId} {
        allow read, write: if false;
      }
      match /crm_notes/{noteId} {
        allow read, write: if false;
      }
      // Histórico de WhatsApp + trava de idempotência da régua. O cliente não
      // pode ler nem, principalmente, apagar — apagar aqui reabriria o envio.
      match /crm_messages/{messageId} {
        allow read, write: if false;
      }

      // Agente unificado (Conteúdo + Operações). O dono lê a conversa para
      // renderizar o chat, mas toda escrita passa pelo servidor: as
      // mensagens são o histórico que alimenta o modelo, e as ações
      // carregam o status de aprovação. Deixar o cliente escrever aqui
      // permitiria forjar um 'approved' e pular o gate. O servidor também
      // grava os checkpoints do LangGraph nesta mesma subcoleção de thread
      // — o cliente nunca acessa `checkpoints` porque não há regra
      // permitindo, então fica bloqueada por padrão.
      match /agent_threads/{threadId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }
      match /agent_actions/{actionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Log de diagnóstico das chamadas HTTP do agente. Só o servidor escreve.
      match /agent_logs/{logId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Trilha de auditoria do que o agente executou: imutável, inclusive para o dono.
      match /agent_audit/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Integration secrets (e.g. Wake token). Written only server-side via the
      // Admin SDK, which bypasses these rules. Clients are fully denied.
      match /integration_secrets/{docId} {
        allow read, write: if false;
      }

      match /credit_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
      
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory();
        allow update: if isOwner(userId) && isValidCategory();
        allow delete: if isOwner(userId);
      }
      
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                     hasRequiredProductFields() && 
                     isValidProduct() && 
                     request.resource.data.ownerId == userId;
        allow update: if isOwner(userId) &&
                     isValidProduct() &&
                     request.resource.data.ownerId == resource.data.ownerId &&
                     (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);

        // Wake import backups / versioning (append-only history owned by the user).
        match /wake_versions/{versionId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                     hasRequiredTemplateFields() &&
                     isValidTemplate() &&
                     request.resource.data.ownerId == userId;
        allow update: if isOwner(userId) &&
                     isValidTemplate() &&
                     request.resource.data.ownerId == resource.data.ownerId &&
                     request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // Video generation jobs. Written server-side via Admin SDK; the client
      // only reads to track progress via onSnapshot.
      match /videoJobs/{jobId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Agência de Criação de Conteúdo (Alfred). The owner manages projects and
      // their clusters/calendar from the client; the AI pipeline + credit debit
      // run server-side via the Admin SDK (which bypasses these rules).
      match /contentProjects/{projectId} {
        allow read, write: if isOwner(userId);

        match /clusters/{clusterId} {
          allow read, write: if isOwner(userId);
        }
        match /calendar/{articleId} {
          // The client reads status/content and may edit/approve drafts, but the
          // pipeline writes happen server-side.
          allow read, write: if isOwner(userId);
        }
        match /seoAudits/{auditId} {
          // Fully server-managed (SE Ranking trigger/refresh via Admin SDK);
          // the client only listens for status/results.
          allow read, write: if isOwner(userId);
        }
        // Sensitive credentials (e.g. WordPress Application Password). The client
        // may write/update them but must NEVER read them back; only the server
        // (Admin SDK) reads this subcollection.
        match /secrets/{secretId} {
          allow read: if false;
          allow write: if isOwner(userId);
        }

        // Blog nativo (CMS). O dono gerencia settings/posts/categorias pelo
        // client; o serving público lê via Admin SDK (bypassa estas regras).
        match /blog/{docId} {
          allow read, write: if isOwner(userId);
        }
        match /blogPosts/{postId} {
          allow read, write: if isOwner(userId);
        }
        match /blogCategories/{catId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}
