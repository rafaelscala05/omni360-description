rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredProductFields() {
      return request.resource.data.keys().hasAll(['ownerId', 'createdAt']);
    }
    
    function hasRequiredTemplateFields() {
      return request.resource.data.keys().hasAll(['name', 'prompt', 'ownerId', 'createdAt']);
    }

    function isValidProduct() {
      let data = request.resource.data;
      return data.ownerId is string &&
             data.createdAt is string &&
             // Internal fields
             (!('_id' in data) || data._id is string) &&
             (!('_statusDescricao' in data) || data._statusDescricao is string) &&
             (!('_statusSEO' in data) || data._statusSEO is string) &&
             (!('_enrichmentLog' in data) || data._enrichmentLog is string) &&
             (!('_generationLog' in data) || data._generationLog is string) &&
             (!('_selectedImage' in data) || data._selectedImage is string) &&
             (!('_ambientImages' in data) || data._ambientImages is list) &&
             (!('_tokenUsage' in data) || data._tokenUsage is map) &&
             // SEO fields (actual keys from App.tsx)
             (!('Título SEO' in data) || data['Título SEO'] is string) &&
             (!('Descrição SEO' in data) || data['Descrição SEO'] is string) &&
             (!('Palavras chave SEO' in data) || data['Palavras chave SEO'] is string) &&
             (!('Descrição complementar' in data) || data['Descrição complementar'] is string);
    }

    function isValidUser() {
      let data = request.resource.data;
      return (!('email' in data) || data.email is string || data.email == null) &&
             (!('displayName' in data) || data.displayName is string || data.displayName == null) &&
             (!('credits' in data) || data.credits is number) &&
             (!('lastSync' in data) || data.lastSync is string);
    }

    // On update, the client may only keep credits the same or DECREASE them
    // (debits via consumeCredit). Any increase (top-up/recharge) must happen
    // server-side with the Admin SDK, which bypasses these rules. This closes
    // the hole where a client could set its own credits to an arbitrary value.
    function creditsNotIncreased() {
      return !('credits' in request.resource.data)
          || !('credits' in resource.data)
          || request.resource.data.credits <= resource.data.credits;
    }

    function isValidTemplate() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() < 5000 &&
             data.ownerId is string &&
             data.createdAt is string;
    }

    function isValidCategory() {
      let data = request.resource.data;
      return (!('id' in data) || data.id is string) &&
             (!('name' in data) || data.name is string) &&
             (!('slug' in data) || data.slug is string) &&
             (!('parentId' in data) || data.parentId is string || data.parentId == null) &&
             (!('level' in data) || data.level is number) &&
             (!('path' in data) || data.path is list) &&
             (!('pathIds' in data) || data.pathIds is list) &&
             (!('attributes' in data) || data.attributes is list) &&
             (!('inheritParentAttributes' in data) || data.inheritParentAttributes is bool) &&
             (!('productCount' in data) || data.productCount is number) &&
             (!('aiGenerated' in data) || data.aiGenerated is bool) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Admin-controlled, read-only configuration (e.g. per-action credit costs).
    // Writes happen only via the Admin SDK / Firebase console, never the client.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pagamentos pendentes — escritos apenas pelo servidor via Admin SDK.
    // O cliente nunca deve ler nem escrever nesta coleção.
    match /pendingPayments/{paymentId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && isValidUser() && creditsNotIncreased();
      allow delete: if isOwner(userId);

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Integration secrets (e.g. Wake token). Written only server-side via the
      // Admin SDK, which bypasses these rules. Clients are fully denied.
      match /integration_secrets/{docId} {
        allow read, write: if false;
      }

      match /credit_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
      
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory();
        allow update: if isOwner(userId) && isValidCategory();
        allow delete: if isOwner(userId);
      }
      
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                     hasRequiredProductFields() && 
                     isValidProduct() && 
                     request.resource.data.ownerId == userId;
        allow update: if isOwner(userId) &&
                     isValidProduct() &&
                     request.resource.data.ownerId == resource.data.ownerId &&
                     (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);

        // Wake import backups / versioning (append-only history owned by the user).
        match /wake_versions/{versionId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                     hasRequiredTemplateFields() &&
                     isValidTemplate() &&
                     request.resource.data.ownerId == userId;
        allow update: if isOwner(userId) &&
                     isValidTemplate() &&
                     request.resource.data.ownerId == resource.data.ownerId &&
                     request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // Video generation jobs. Written server-side via Admin SDK; the client
      // only reads to track progress via onSnapshot.
      match /videoJobs/{jobId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Agência de Criação de Conteúdo (Alfred). The owner manages projects and
      // their clusters/calendar from the client; the AI pipeline + credit debit
      // run server-side via the Admin SDK (which bypasses these rules).
      match /contentProjects/{projectId} {
        allow read, write: if isOwner(userId);

        match /clusters/{clusterId} {
          allow read, write: if isOwner(userId);
        }
        match /calendar/{articleId} {
          // The client reads status/content and may edit/approve drafts, but the
          // pipeline writes happen server-side.
          allow read, write: if isOwner(userId);
        }
        // Sensitive credentials (e.g. WordPress Application Password). The client
        // may write/update them but must NEVER read them back; only the server
        // (Admin SDK) reads this subcollection.
        match /secrets/{secretId} {
          allow read: if false;
          allow write: if isOwner(userId);
        }
      }
    }
  }
}
